DISCORD_TOKEN=YOUR-BOT-TOKEN

# Optional — point the bot at ANY Lavalink node(s) without editing config.json.
# JSON array of node objects; multiple entries = multiple nodes (failover/load balance).
# Leave unset to keep using the node(s) listed in config.json (public nodes with
# Spotify/Apple Music/Deezer support via the LavaSrc plugin, pre-configured for failover).
# LAVALINK_NODES=[{"id":"main","host":"localhost","port":2333,"authorization":"youshallnotpass","secure":false}]

# NOTE ON PUBLIC LAVALINK NODES:
# The nodes shipped in config.json are free public nodes (nyxbot.app, jirayu.net).
# They're convenient for getting Spotify/YouTube playlists working immediately,
# but free public nodes can go down or change passwords without notice — that's
# almost certainly why the previous node stopped working. For anything you're
# running long-term, self-host Lavalink with the LavaSrc plugin instead (see
# README.md for a docker-compose + application.yml example) and point
# LAVALINK_NODES at it.


